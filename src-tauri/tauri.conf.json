{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "刷题宝",
  "version": "0.1.3",
  "identifier": "com.shuati-bao.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "刷题宝",
        "width": 1024,
        "height": 720,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/MYT6666/shuati-bao/main/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3NTZFMEY3NTc1NkVFMEEKUldRSzdsWlg5K0JXWnhJeEpMOUhGMVRiNkJDcXhFVzNDRTUxZXdiZng2UHJHQzlpYm90c1RjTHkK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
